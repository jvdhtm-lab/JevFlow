API_URL=http://django:8000
PORT=4000
# Service token for macaco server-to-server calls (provider keys, social
# login). Print it with: docker exec jevflow_django python create_superuser.py
# NEVER commit a real token — copy this file to .env and fill it in locally.
API_TOKEN=PASTE_ROOT_TOKEN_HERE
# Legacy per-provider env fallback (used only when Django has no keys for a
# provider). Prefer the Settings page in the UI.
GOOGLE_CLIENT_ID=dummy-google-id
GOOGLE_CLIENT_SECRET=dummy-google-secret
AZURE_CLIENT_ID=dummy-azure-id
AZURE_CLIENT_SECRET=dummy-azure-secret
SLACK_CLIENT_ID=dummy-slack-id
SLACK_CLIENT_SECRET=dummy-slack-secret
GITHUB_CLIENT_ID=dummy-github-id
GITHUB_CLIENT_SECRET=dummy-github-secret
X_CLIENT_ID=dummy-x-id
X_CLIENT_SECRET=dummy-x-secret
